# ==============================================================================
# Secure SMTP — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure appropriate values for your deployment.
# NEVER commit your actual .env containing production secrets to version control.
# ==============================================================================

# ── 1. Application Metadata & Operational Mode ──
SECURE_SMTP_APP_NAME="Secure SMTP"
SECURE_SMTP_ENV="production" # Options: development, testing, staging, production
SECURE_SMTP_DEBUG=false
# In production, set to false to prevent the container from binding demo ports 2525-2528
SECURE_SMTP_ENABLE_LIVE_LAB=true

# ── 2. Security & API Authentication ──
# Change this to a cryptographically secure key (e.g. openssl rand -hex 32)
# NOTE: In production (SECURE_SMTP_ENV=production), startup will FAIL FAST if the default key is used.
SECURE_SMTP_API_KEY="securesmtp_live_secret_key"
SECURE_SMTP_AUTH_REQUIRED=true

# ── 3. Rate Limiting & Safety Quotas ──
SECURE_SMTP_RATE_LIMIT_ENABLED=true
SECURE_SMTP_RATE_LIMIT_RPM=120
SECURE_SMTP_MAX_UPLOAD_SIZE_MB=100

# ── 4. Cross-Origin Resource Sharing (CORS) ──
# Comma-separated list of permitted origins. In production, specify your exact domain.
# e.g.: https://securesmtp.corp.io,https://admin.corp.io
SECURE_SMTP_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost"
SECURE_SMTP_CORS_HEADERS="*"

# ── 4. MongoDB Database Credentials ──
# Explicit MongoDB URI (e.g. MongoDB Atlas cluster) or standalone connection parameters
SECURE_SMTP_MONGO_URI=""
SECURE_SMTP_MONGO_HOST="localhost"
SECURE_SMTP_MONGO_PORT=27017
SECURE_SMTP_MONGO_DB="secure_smtp"
SECURE_SMTP_MONGO_USER="secure_admin"
SECURE_SMTP_MONGO_PASSWORD=""
SECURE_SMTP_MONGO_AUTH_DB="admin"
SECURE_SMTP_MONGO_AUTH_MECHANISM="SCRAM-SHA-256"
SECURE_SMTP_MONGO_AUTH_REQUIRED=true

# ── 5. File Storage & Report Directories ──
SECURE_SMTP_UPLOAD_DIR="/tmp/secure_smtp_uploads"
SECURE_SMTP_REPORTS_DIR="/tmp/secure_smtp_reports"

# ── 6. Generative AI Security Copilot (Optional) ──
# Provide a Google Gemini API Key to enable live GenAI analysis & incident memos.
# If omitted, Secure SMTP falls back to the deterministic cryptographic synthesizer.
# GEMINI_API_KEY="your-google-gemini-api-key"

# ── 7. SIEM & ChatOps Security Webhooks ──
SECURE_SMTP_ALERTS_ENABLED=false
# SECURE_SMTP_ALERT_WEBHOOK_URL="https://hooks.slack.com/services/T00/B00/XXXX"
# Optional HMAC-SHA256 signature secret for authenticating payloads
# SECURE_SMTP_ALERT_WEBHOOK_SECRET="shared-secret-key"
SECURE_SMTP_ALERT_MIN_SEVERITY="HIGH"
SECURE_SMTP_ALERT_RISK_THRESHOLD=75.0
