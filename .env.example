# Copy to .env; never commit secrets. Fresh pilot database recommended.
PILOT_DOMAIN=mail-security.example.com
VITE_CLERK_PUBLISHABLE_KEY=
SECURE_SMTP_CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Optional aud claim: configure this in Clerk session customization, not a JWT template.
SECURE_SMTP_CLERK_AUDIENCE=
SECURE_SMTP_CLERK_AUTHORIZED_PARTIES=["https://mail-security.example.com"]
SECURE_SMTP_PUBLIC_REGISTRATION=true
# Optional shared pilot organization; personal sign-up does not require membership.
SECURE_SMTP_PILOT_ORG_ID=
SECURE_SMTP_CORS_ORIGINS=["https://mail-security.example.com"]
# Root credentials are used only by database initialization and recovery.
MONGO_ROOT_USER=pilot_admin
MONGO_ROOT_PASSWORD=
SECURE_SMTP_MONGO_USER=pilot_app
SECURE_SMTP_MONGO_PASSWORD=
SECURE_SMTP_MONGO_HOST=localhost
SECURE_SMTP_MONGO_DB=secure_smtp_pilot
SECURE_SMTP_MONGO_AUTH_DB=secure_smtp_pilot
SECURE_SMTP_MONGO_AUTH_REQUIRED=true
SECURE_SMTP_ENABLE_LIVE_LAB=false
SECURE_SMTP_MAX_UPLOAD_BYTES=26214400
SECURE_SMTP_ANALYSIS_TIMEOUT_SECONDS=120
SECURE_SMTP_UPLOAD_DIR=/tmp/secure_smtp_uploads
SECURE_SMTP_REPORTS_DIR=/tmp/secure_smtp_reports
SECURE_SMTP_ALERTS_ENABLED=false
SECURE_SMTP_ALERT_MIN_SEVERITY=HIGH
SECURE_SMTP_ALERT_RISK_THRESHOLD=75
SECURE_SMTP_RETENTION_DAYS=30
SECURE_SMTP_AGENT_OFFLINE_SECONDS=90
# Optional: configure only after reviewing metadata shared with these services.
SECURE_SMTP_NEO4J_URI=
SECURE_SMTP_NEO4J_USER=neo4j
SECURE_SMTP_NEO4J_PASSWORD=
SECURE_SMTP_ALERT_WEBHOOK_URL=
SECURE_SMTP_ALERT_WEBHOOK_SECRET=
# Optional server-only integration credentials, after approval of data handling:
# GEMINI_API_KEY=
# SECURE_SMTP_ALERT_WEBHOOK_URL=
# SECURE_SMTP_ALERT_WEBHOOK_SECRET=
