# ==============================================================================
# Secure SMTP — Enterprise Frontend Dockerfile
# ==============================================================================
# Multi-stage container: builds Vite React application and serves with Nginx Alpine.
# ==============================================================================

FROM node:22-alpine AS builder

WORKDIR /app

# Copy package manifests & install dependencies
COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/package.json
RUN npm ci

# Copy frontend source code & build optimized bundle
COPY frontend/ ./frontend/
WORKDIR /app/frontend
ARG VITE_AUTH_PROVIDER=clerk
ENV VITE_AUTH_PROVIDER=$VITE_AUTH_PROVIDER
ARG VITE_CLERK_PUBLISHABLE_KEY
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY
RUN npm run build

# ==============================================================================
# Runtime Stage (Nginx Alpine)
# ==============================================================================
FROM nginx:alpine AS runtime

# Remove default nginx configurations
RUN rm -rf /etc/nginx/conf.d/* /usr/share/nginx/html/*

# Copy custom Nginx configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled assets from builder
COPY --from=builder /app/frontend/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=20s --timeout=5s --retries=3 \
    CMD wget -q -O - http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
