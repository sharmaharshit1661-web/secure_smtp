# Secure SMTP — Frontend Environment Variables

# Central FastAPI Backend URL (leave empty for default Vite dev proxy to localhost:8000)
VITE_API_BASE=

# Secure SMTP API Security Key
VITE_API_KEY=securesmtp_live_secret_key

# Clerk Authentication Publishable Key
# Get yours from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=
